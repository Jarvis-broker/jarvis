# Gemini API key — https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Live model — native-audio variant gives best voice quality
VITE_GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025

# Prebuilt voice: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr
VITE_GEMINI_VOICE=Charon
